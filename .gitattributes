# Keep repository text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Explicit binary assets: never perform line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
